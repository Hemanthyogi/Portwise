# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=portwise_db
POSTGRES_USER=portwise
POSTGRES_PASSWORD=portwise_secret

# ─── Spring Boot ──────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/portwise_db
SPRING_DATASOURCE_USERNAME=portwise
SPRING_DATASOURCE_PASSWORD=portwise_secret

JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_chars_for_production
JWT_EXPIRATION_MS=86400000

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ─── Demo flag ────────────────────────────────────────────────
DEMO_MODE=true
